# Summary tables (table*.csv) ARE tracked — see top comment.
MatProcAgent/ProvMind/results/
MatProcAgent/ProvMind/results_traceflow/

# Baseline inference outputs and RAG embedding caches
# (table1–5_*.csv result summaries are kept; raw prediction JSONL are not)
MatProcAgent/baselines/results/
# Allow the small CSV summary tables back in
!MatProcAgent/baselines/results/table*.csv


# ── Intermediate / backup figure directories ──────────────────────────────────
